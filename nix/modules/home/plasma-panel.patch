+
+    // A press anywhere on the panel closes the open popup, except the one belonging to the
+    // widget under the press, which toggles itself. Popups close when they lose focus and the
+    // panel never takes focus, so they otherwise stay open. This item lies above the widgets
+    // and only watches: a PointHandler neither accepts nor grabs the press, so it still reaches
+    // the widget beneath (the taskbar fills most of the panel and accepts every press). A
+    // TapHandler here would accept it and starve every widget's MouseArea. A pinned popup
+    // (Keep open) stays.
+    Item {
+        anchors.fill: parent
+        PointHandler {
+            acceptedButtons: Qt.AllButtons
+            onActiveChanged: if (active) Containment.applets
+                .map(applet => root.itemFor(applet))
+                .filter(item => item && item.expanded && item.hideOnWindowDeactivate
+                    && !item.contains(item.mapFromItem(root, point.position)))
+                .forEach(item => item.expanded = false)
+        }
+    }
     MouseArea {
         anchors.fill: parent
