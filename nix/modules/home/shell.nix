{
  config,
  pkgs,
  lib,
  ...
}:
let
  secrets = config.personal.shell.secrets;
  secretsCache = "${config.xdg.cacheHome}/personal-secrets/shell-env.sh";
  # Regenerates the private runtime copy of mapped credentials from the central store.
  refreshSecrets = pkgs.writeShellApplication {
    name = "personal-secrets-shell-env";
    runtimeInputs = [ pkgs.python3 ];
    text = ''
      exec python3 "$HOME/repos/skamensky/personal-gcp/scripts/personal-secrets.py" shell-env \
        --map ${pkgs.writeText "shell-secrets.json" (builtins.toJSON secrets)} \
        --output ${secretsCache}
    '';
  };
in
{
  options.personal.shell.secrets = lib.mkOption {
    type = lib.types.attrsOf lib.types.str;
    default = { };
    description = "Environment variable to personal-secrets JSON pointer; values load from a private cache.";
  };
  config = {
    home.packages = lib.optional (secrets != { }) refreshSecrets;
    home.sessionVariables = {
      EDITOR = "vim";
      VISUAL = "vim";
    };
    home.sessionPath = [
      "$HOME/.local/bin"
      "$HOME/bin"
      "$HOME/.cargo/bin"
    ];
    programs.bash = {
      enable = true;
      enableCompletion = true;
      historyControl = [ "ignoreboth" ];
      historySize = 10000;
      historyFileSize = 20000;
      shellOptions = [
        "histappend"
        "checkwinsize"
      ];
      shellAliases = {
        ll = "ls -alF";
        la = "ls -A";
        l = "ls -CF";
        claude_dangerous = "claude --dangerously-skip-permissions";
        codex_dangerous = "codex --dangerously-bypass-approvals-and-sandbox";
        corteza_ssh_forward = "ssh -4 -fN -o ExitOnForwardFailure=yes -L 127.0.0.1:65432:localhost:54321 corteza";
        tmain = "$HOME/repos/SkylineCapital/supa-crm/start-tmux-session.sh";
      gemini_who_am_i = "jq -r .id_token ~/.gemini/oauth_creds.json | cut -d. -f2 | base64 -d | jq -r .email";
      };
      # Above .bashrc's interactive-only guard: agent and tool shells source .bashrc
      # non-interactively and need the same credentials (gh reads GITHUB_TOKEN).
      bashrcExtra = lib.optionalString (secrets != { }) ''
        # Generated by personal-secrets-shell-env; rerun it after changing a stored credential.
        if [ -r ${secretsCache} ]; then source ${secretsCache}; fi
      '';
      initExtra = ''
        source ${../../../config/shell/completions/supabase.bash}
        source ${../../../config/shell/completions/shmutils.sh.bash}
        source ${../../../config/shell/completions/tmux.sh.bash}
      '';
    };
    programs.fzf = {
      enable = true;
      enableBashIntegration = true;
    };
    programs.tmux = {
      enable = true;
      mouse = true;
      keyMode = "vi";
      extraConfig = ''
        unbind -T copy-mode-vi MouseDragEnd1Pane
        unbind -T copy-mode MouseDragEnd1Pane
        bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "${
          if config.personal.environment == "wsl" then
            "clip.exe"
          else if config.personal.desktop.session == "x11" then
            "${pkgs.xclip}/bin/xclip -selection clipboard"
          else
            "${pkgs.wl-clipboard}/bin/wl-copy"
        }"
        bind-key j display-popup -E "tmux list-windows -F '#{window_index}: #{window_name}' | fzf --reverse | cut -d: -f1 | xargs -I {} tmux select-window -t {}"
      '';
    };
  };
}
