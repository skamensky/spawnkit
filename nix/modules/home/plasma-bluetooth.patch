diff -ruN a/qml/FullRepresentation.qml b/qml/FullRepresentation.qml
--- a/qml/FullRepresentation.qml
+++ b/qml/FullRepresentation.qml
@@ -18,6 +18,7 @@
 import org.kde.plasma.core as PlasmaCore
 import org.kde.plasma.extras as PlasmaExtras
 import org.kde.plasma.plasmoid
+import org.kde.plasma.plasma5support as P5Support
 import org.kde.plasma.private.bluetooth as PlasmaBt
 import org.kde.bluedevil.components as BluedevilComponents
 
@@ -46,6 +47,66 @@
         }
     }
 
+    // Spawnkit: a device whose pairing changed on its side (a Logitech mouse takes a new address
+    // whenever a channel button pairs again) never connects at its old address, and its new one
+    // is not listed because it is unpaired. While the popup is open, spawnkit-bluetooth finds such
+    // devices, and their entries offer Re-pair, which pairs the new address and forgets the old.
+    readonly property string bluetoothTool: "@bluetooth@"
+    property var replacements: ({})
+    property var repairing: ({})
+    property var repairErrors: ({})
+    readonly property bool anyDisconnected: BluezQt.Manager.devices.some(device => device.paired && !device.connected)
+
+    function repair(address: string, replacement: string): void {
+        repairing = Object.assign({}, repairing, {[address]: true});
+        const errors = Object.assign({}, repairErrors);
+        delete errors[address];
+        repairErrors = errors;
+        bluetoothRunner.connectSource(`${bluetoothTool} repair ${address} ${replacement}`);
+    }
+
+    Timer {
+        interval: 8000
+        repeat: true
+        triggeredOnStart: true
+        running: root.plasmoidItem.expanded && root.anyDisconnected && BluezQt.Manager.bluetoothOperational
+        onTriggered: bluetoothRunner.connectSource(`${root.bluetoothTool} stale --scan 6`)
+    }
+
+    P5Support.DataSource {
+        id: bluetoothRunner
+        engine: "executable"
+        onNewData: (source, data) => {
+            disconnectSource(source);
+            let result = null;
+            try {
+                result = JSON.parse(data.stdout);
+            } catch (error) {
+                result = {error: data.stderr.trim() || i18n("Re-pairing failed")};
+            }
+            const words = source.split(" ");
+            if (words[1] === "stale") {
+                const found = {};
+                for (const device of Array.isArray(result) ? result : []) {
+                    found[device.address] = device.replacement;
+                }
+                root.replacements = found;
+                return;
+            }
+            const address = words[2];
+            const repairing = Object.assign({}, root.repairing);
+            delete repairing[address];
+            root.repairing = repairing;
+            const replacements = Object.assign({}, root.replacements);
+            delete replacements[address];
+            if (result && result.error) {
+                root.repairErrors = Object.assign({}, root.repairErrors, {[address]: result.error});
+                replacements[address] = words[3];
+            }
+            root.replacements = replacements;
+        }
+    }
+
     PlasmaBt.DevicesProxyModel {
         id: devicesModel
         hideBlockedDevices: true
@@ -131,6 +192,10 @@
             highlightResizeDuration: Kirigami.Units.shortDuration
