+int PlacesPanel::fittingWidth() const
+{
+    const QFontMetrics metrics(font());
+    int widest = 0;
+    for (int row = 0; row < model()->rowCount(); ++row) {
+        if (!isRowHidden(row)) {
+            widest = std::max(widest, metrics.horizontalAdvance(model()->index(row, 0).data(Qt::DisplayRole).toString()));
+        }
+    }
+    return widest + iconSize().width() + 3 * metrics.height() + verticalScrollBar()->sizeHint().width() + 2 * frameWidth();
+}
