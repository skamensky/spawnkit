+    // spawnkit: widen the Places panel whenever a place's name would not fit, up to a third of
+    // the window; it can still be dragged wider.
+    const auto fitPlaces = [this, placesDock]() {
+        const int width = std::min(m_placesPanel->fittingWidth(), this->width() / 3);
+        if (placesDock->isVisible() && !placesDock->isFloating() && placesDock->widget()->width() < width) {
+            resizeDocks({placesDock}, {width + placesDock->width() - placesDock->widget()->width()}, Qt::Horizontal);
+        }
+    };
+    const auto fitPlacesSoon = [this, fitPlaces]() {
+        QTimer::singleShot(0, this, fitPlaces);
+    };
+    connect(placesDock, &QDockWidget::visibilityChanged, this, fitPlacesSoon);
+    connect(m_placesPanel->model(), &QAbstractItemModel::rowsInserted, this, fitPlacesSoon);
+    connect(m_placesPanel->model(), &QAbstractItemModel::dataChanged, this, fitPlacesSoon);
