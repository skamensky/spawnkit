+++ b/src/kitemviews/private/spawnkitdiskusage.h
@@ -0,0 +1,59 @@
+/*
+ * spawnkit: disk space per directory, from the index the spawnkit-disk-usage command keeps.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef SPAWNKITDISKUSAGE_H
+#define SPAWNKITDISKUSAGE_H
+
+#include <QHash>
+#include <QObject>
+#include <QSet>
+#include <QStringList>
+#include <QTimer>
+
+/**
+ * Sizes come from the index at once, however stale. Opening a directory recomputes its subtree
+ * in the background a moment later, and the fresh sizes replace the indexed ones.
+ */
+class SpawnkitDiskUsage : public QObject
+{
+    Q_OBJECT
+
+public:
+    static SpawnkitDiskUsage *instance();
+
+    /** The directory a view opened: read its indexed sizes now and recompute its subtree shortly. */
+    void visit(const QString &directory);
+    /** Read the indexed sizes of \a directory and its subdirectories, unless they are known. */
+    void load(const QString &directory);
+    /** Bytes the directory \a path occupies, or -1 while unknown. */
+    qint64 size(const QString &path) const;
+    /** Whether \a directory's subtree is being recomputed. */
+    bool refreshing(const QString &directory) const;
+
+    static QString parentOf(const QString &path);
+
+Q_SIGNALS:
+    /** The sizes of \a directory and its subdirectories were read, or its recomputation started. */
+    void updated(const QString &directory);
+
+private:
+    struct Listing {
+        qint64 total = -1;
+        QHash<QString, qint64> children;
+    };
+
+    explicit SpawnkitDiskUsage();
+    void query(const QStringList &directories);
+    void refresh(const QString &directory);
+
+    QString m_program;
+    QHash<QString, Listing> m_listings;
+    QSet<QString> m_refreshing;
+    QString m_visited;
+    QTimer m_visitTimer;
+};
+
+#endif
