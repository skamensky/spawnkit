+/*
+ * spawnkit: disk space per directory, from the index the spawnkit-disk-usage command keeps.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "spawnkitdiskusage.h"
+
+#include <QDebug>
+#include <QDir>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QProcess>
+#include <QStandardPaths>
+
+namespace
+{
+// Leaving a directory within this time starts no recomputation: passing through is not a visit.
+const int s_visitDelay = 700;
+const int s_maxListings = 256;
+}
+
+SpawnkitDiskUsage *SpawnkitDiskUsage::instance()
+{
+    static SpawnkitDiskUsage *usage = new SpawnkitDiskUsage();
+    return usage;
+}
+
+SpawnkitDiskUsage::SpawnkitDiskUsage()
+    : QObject(nullptr)
+    , m_program(QStandardPaths::findExecutable(QStringLiteral("spawnkit-disk-usage")))
+{
+    if (m_program.isEmpty()) {
+        qWarning() << "spawnkit-disk-usage is not on PATH: folders show no size";
+    }
+    m_visitTimer.setSingleShot(true);
+    m_visitTimer.setInterval(s_visitDelay);
+    connect(&m_visitTimer, &QTimer::timeout, this, [this]() {
+        refresh(m_visited);
+    });
+}
+
+QString SpawnkitDiskUsage::parentOf(const QString &path)
+{
+    const int slash = path.lastIndexOf(QLatin1Char('/'));
+    return slash <= 0 ? QStringLiteral("/") : path.left(slash);
+}
+
+void SpawnkitDiskUsage::visit(const QString &directory)
+{
+    const QString path = QDir::cleanPath(directory);
+    // Another process may have rescanned since this listing was read.
+    query({path});
+    m_visited = path;
+    m_visitTimer.start();
+}
+
+void SpawnkitDiskUsage::load(const QString &directory)
+{
+    if (!m_listings.contains(directory)) {
+        query({directory});
+    }
+}
+
+qint64 SpawnkitDiskUsage::size(const QString &path) const
+{
+    const auto own = m_listings.constFind(path);
+    if (own != m_listings.constEnd() && own->total >= 0) {
+        return own->total;
+    }
+    const auto parent = m_listings.constFind(parentOf(path));
+    if (parent == m_listings.constEnd()) {
+        return -1;
+    }
+    return parent->children.value(path.mid(path.lastIndexOf(QLatin1Char('/')) + 1), -1);
+}
+
+bool SpawnkitDiskUsage::refreshing(const QString &directory) const
+{
+    return m_refreshing.contains(directory);
+}
+
+void SpawnkitDiskUsage::query(const QStringList &directories)
+{
+    if (m_program.isEmpty() || directories.isEmpty()) {
+        return;
+    }
+    if (m_listings.size() > s_maxListings) {
+        m_listings.clear();
+    }
+    for (const QString &directory : directories) {
+        // Present from now on, so load() asks once.
+        m_listings[directory];
+    }
+
+    auto process = new QProcess(this);
+    connect(process, &QProcess::finished, this, [this, process, directories]() {
+        process->deleteLater();
+        const QJsonObject listings = QJsonDocument::fromJson(process->readAllStandardOutput()).object().value(QLatin1String("directories")).toObject();
+        for (const QString &directory : directories) {
+            const QJsonObject found = listings.value(directory).toObject();
+            Listing listing;
+            listing.total = found.value(QLatin1String("bytes")).isDouble() ? found.value(QLatin1String("bytes")).toInteger() : -1;
+            const QJsonObject children = found.value(QLatin1String("children")).toObject();
+            for (auto child = children.constBegin(); child != children.constEnd(); ++child) {
+                listing.children.insert(child.key(), child.value().toInteger());
+            }
+            m_listings.insert(directory, listing);
+            Q_EMIT updated(directory);
+        }
+    });
+    connect(process, &QProcess::errorOccurred, process, &QObject::deleteLater);
+    process->start(m_program, QStringList{QStringLiteral("ls"), QStringLiteral("--json"), QStringLiteral("--")} + directories);
+}
+
+void SpawnkitDiskUsage::refresh(const QString &directory)
+{
+    if (m_program.isEmpty() || m_refreshing.contains(directory)) {
+        return;
+    }
+    m_refreshing.insert(directory);
+    Q_EMIT updated(directory);
+
+    auto process = new QProcess(this);
+    const auto done = [this, process, directory]() {
+        process->deleteLater();
+        if (!m_refreshing.remove(directory)) {
+            return;
+        }
+        // Every listing read from the old subtree is stale now.
+        QStringList stale{directory};
+        const QString below = directory.endsWith(QLatin1Char('/')) ? directory : directory + QLatin1Char('/');
+        for (auto listing = m_listings.constBegin(); listing != m_listings.constEnd(); ++listing) {
+            if (listing.key() != directory && listing.key().startsWith(below)) {
+                stale << listing.key();
+            }
+        }
+        query(stale);
+    };
+    connect(process, &QProcess::finished, this, done);
+    connect(process, &QProcess::errorOccurred, this, done);
+    process->start(m_program, {QStringLiteral("refresh"), QStringLiteral("--"), directory});
+}
+
